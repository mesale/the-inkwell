# ─────────────────────────────────────────────────────────────
# Backend environment template — copy to `.env` in this folder:
#   cp .env.example .env
# docker-compose automatically loads `.env` from this directory.
# ─────────────────────────────────────────────────────────────

# ── PostgreSQL (shared by app services + Keycloak) ──
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# ── MinIO (object storage for book cover images) ──
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ── Keycloak admin console (master realm) ──
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin123

# ── Keycloak service account used by the backend admin API ──
# CLIENT_SECRET must match the "secret" of the bookstore-backend client in
# keycloak/import/bookstore-realm-realm.json (default: local-dev-backend-secret).
KEYCLOAK_ADMIN_CLIENT_ID=bookstore-backend
KEYCLOAK_ADMIN_CLIENT_SECRET=local-dev-backend-secret

# ── Frontend URL (used in outgoing emails + Stripe redirects) ──
APP_FRONTEND_URL=http://localhost:5173

# ── Email / SMTP (OPTIONAL) ──
# Required only for register/invite/password-reset emails.
# For Gmail use an App Password (not your normal password).
MAIL_USERNAME=
MAIL_PASSWORD=

# ── Stripe (OPTIONAL) ──
# Required only for checkout, payouts and premium subscriptions.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=
STRIPE_PREMIUM_PRICE_ID=
