# ─────────────────────────────────────────────────────────────
# Frontend environment template — copy to `.env`:
#   cp .env.example .env
# Vite exposes only variables prefixed with VITE_ to the app.
# ─────────────────────────────────────────────────────────────

# Base URL axios uses. Keep as /api so the Vite dev server proxies requests to
# the gateway (avoids CORS in local dev). Use a full URL only to bypass the proxy.
VITE_API_GATEWAY_URL=/api

# Where the Vite dev server forwards /api requests (the API gateway).
VITE_API_PROXY_TARGET=http://localhost:8087

# Keycloak (browser-facing).
# IMPORTANT: this host MUST match the backend's KEYCLOAK_ISSUER_URI host
# (http://localhost:8080). If they differ, the token's `iss` claim won't match
# and every authenticated API call will be rejected with 401.
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=bookstore-realm
VITE_KEYCLOAK_CLIENT_ID=bookstore-frontend

# Stripe publishable key (OPTIONAL; only the checkout UI needs it).
VITE_STRIPE_PUBLIC_KEY=pk_test_replace_me
